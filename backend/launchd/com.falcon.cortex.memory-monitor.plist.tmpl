<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.falcon.cortex.memory-monitor</string>

    <!-- 别改回 /bin/bash 直跑 .sh：仓在 ~/Documents（TCC 保护目录），launchd 里
         /bin/bash 访问仓内文件一律 Operation not permitted，挂上去只会每次 exit 126。
         先起仓内 venv 的 python（它有权限），由它 spawn bash 跑脚本，权限才继承得到。
         完整实测见 scripts/health/memory_monitor_launchd.py 的文档字符串。 -->
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON3@</string>
        <string>@INSTALL_ROOT@/scripts/memory_monitor_launchd.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@INSTALL_ROOT@</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>@SENTINEL_HOME@/logs/memory-monitor.log</string>

    <key>StandardErrorPath</key>
    <string>@SENTINEL_HOME@/logs/memory-monitor.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PYTHONPATH</key>
        <string>@INSTALL_ROOT@</string>
        <key>CORTEX_SENTINEL_HOME</key>
        <string>@SENTINEL_HOME@</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
