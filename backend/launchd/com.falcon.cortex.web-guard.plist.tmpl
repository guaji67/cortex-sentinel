<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  有意不挂进 launchd，不是漏了，别顺手挂上。

  Falcon 2026-08-18 钉死的纪律是「起了 dev server 的人负责关」，原话：
  不要什么东西都是开了就不管了、不关了，你这不是坑我吗。
  而这份 plist 做的事是自动把挂掉的 dev server 重启起来——它正好抵消那条纪律：
  一个自动帮人兜住的守护会让「开了不管」没有后果，于是更多人开了不管。这是方向问题，
  不是配置问题。（主控 2026-08-18 裁定，理由记在这里以免下一个人当成遗漏。）

  另外两个当时评估过的选项也不要：
  - 只探测不 heal：会变成「知道坏了但没人管」，比不探测更糟，它制造一种有人在看着的错觉。
  - 等「给可执行体授一次完全磁盘访问」那条路：等于无限期搁置。

  顺带一条技术事实（真要挂的时候会撞上）：这份 plist 是 /bin/bash 直跑仓内脚本的形状，
  而仓住在 ~/Documents（TCC 保护目录），launchd 下这么跑一律 exit 126。
  实测对照见 docs/reference/macos-tcc-authorization-persistence.md 的「第四条补边界」那节；
  真要挂的正解是照 scripts/health/install_health_runtime.sh 那样部署到仓外，
  但那对这份守护不成立——它的活本身就是重启仓内的 dev server，搬到仓外也得回来碰仓内。
-->
<dict>
    <key>Label</key>
    <string>com.falcon.cortex.web-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@INSTALL_ROOT@/scripts/web-dev-health.sh</string>
        <string>heal</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@INSTALL_ROOT@</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>150</integer>

    <key>StandardOutPath</key>
    <string>@SENTINEL_HOME@/logs/web-guard.log</string>

    <key>StandardErrorPath</key>
    <string>@SENTINEL_HOME@/logs/web-guard.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CORTEX_WEB_IDLE_TIMEOUT_SECONDS</key>
        <string>0</string>
        <key>CORTEX_WEB_BIND_HOST</key>
        <string>0.0.0.0</string>
        <key>CORTEX_WEB_HEALTH_TIMEOUT_SECONDS</key>
        <string>120</string>
        <key>CORTEX_WEB_FAILURE_THRESHOLD</key>
        <string>2</string>
        <key>CORTEX_WEB_RESTART_GRACE_SECONDS</key>
        <string>300</string>
        <key>CORTEX_WEB_WARMUP_TIMEOUT_SECONDS</key>
        <string>180</string>
    </dict>
</dict>
</plist>
